{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Compilar Raylib",
      "command": "./run_jogo.sh",
      "args": ["--build-only"],
      "windows": {
        "command": "${workspaceFolder}\\run_jogo.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "type": "shell",
      "label": "Executar jogo",
      "command": "./run_jogo.sh",
      "args": [],
      "windows": {
        "command": "${workspaceFolder}\\run_jogo.bat"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
